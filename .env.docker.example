# LiftShift Docker env — copy to `.env` and adjust. Never commit `.env`.
# If you already have a `.env` for local dev, back it up first
# (`cp .env .env.backup`) or skip copying entirely and run:
#   docker compose --env-file .env.docker.example up --build
# See DOCKER.md for full guide.
#
# Privacy: self-host images are tracking-free (no PostHog, no Google
# Analytics, no ads.txt, no affiliate tags). There are no analytics knobs
# here on purpose — nothing phones home.

# --- Ports ---
# Only the frontend is published to your machine. The backend stays inside
# Docker's network (reached via the frontend proxy), so host port 5000 —
# often taken by macOS AirPlay Receiver — can never collide.
FRONTEND_PORT=3000
# Uncomment to also publish the backend for direct debugging:
# BACKEND_PORT=5051

# --- Backend (Hevy/Lyfta proxy) ---
# Required for Hevy email+password login and Pro API sync.
# CSV-only users can leave this empty (or run the frontend-only profile).
HEVY_X_API_KEY=
HEVY_BASE_URL=https://api.hevyapp.com
# FRONTEND_PORT must be listed here if the browser calls the backend directly.
# Same-origin /api via Nginx (default) bypasses CORS entirely.
CORS_ORIGINS=http://localhost:3000

# --- Frontend runtime backend override (no rebuild) ---
# "" = same-origin /api via Nginx proxy (recommended for local self-host).
# Set to a hosted backend to skip local backend, e.g.:
# BACKEND_URL=https://liftshift-backend.onrender.com
BACKEND_URL=

# --- Frontend build-time (baked into bundle, rebuild to change) ---
VITE_BACKEND_URL=
VITE_BASE_PATH=/
BASE_ASSETS=/

# --- Prebuilt images (pull compose only) ---
# :latest tracks every merge to main. Pin :vX.Y.Z or :sha-xxxxxxx for stability.
LIFTSHIFT_TAG=latest
